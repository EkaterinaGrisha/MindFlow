# ── Frontend (Vite exposes these automatically) ───────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Plausible Analytics domain (privacy-first, no cookies).
# Set to your site domain to enable, e.g. "mindflow.app". Leave empty to disable.
VITE_PLAUSIBLE_DOMAIN=
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ1eGlua3Jzdmdxc2Fob3dsYmJuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU4OTQ3MjQsImV4cCI6MjA5MTQ3MDcyNH0.38kuXHPsipI6A621x87fh8knblfwGXqbu3mGi6X8ZH8

# Frontend API target.
# Dev: leave empty and Vite proxies /api to localhost:8787.
# Prod (Railway web service): set to your API service public URL at build time.
VITE_API_BASE_URL=

# ── LLM Providers ──────────────────────────────────────────────────────────────
# Primary: Cloudflare Workers AI (single active LLM provider)
# Get these in dash.cloudflare.com → AI → Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
CLOUDFLARE_DEBUG=0

# Optional DeepSeek fallback (paid, optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embed

# Optional (Cloudflare AI Gateway on dash.cloudflare.com):
# 1) Create AI Gateway in Cloudflare dashboard.
# 2) Put your gateway endpoint as DEEPSEEK_BASE_URL and keep /v1 at the end.
#    Example: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_name>/openai
# 3) If your gateway requires token auth, set CLOUDFLARE_AI_GATEWAY_TOKEN.
CLOUDFLARE_AI_GATEWAY_TOKEN=

# Optional (currently not used for text generation):
GEMINI_API_KEY=

# Optional (currently not used for text generation):
OPENROUTER_API_KEY=<openrouter-key>
OPENROUTER_MODEL=openrouter/free

# OpenRouter embeddings (OpenAI-compatible /v1/embeddings).
# Default: openai/text-embedding-3-small (cheap, ~$0.02/M tokens).
# OpenRouter does NOT currently expose a free embeddings router —
# truly free embedding models on the platform are scarce, so leaving the
# default paid model is recommended; override via this variable if needed.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Force a specific embedding provider order: openrouter | cloudflare
# Default: openrouter first, then cloudflare.
EMBEDDING_PROVIDER=

# ── Supabase (backend-only, never expose to frontend) ────────────────────────
# Used by API for JWT validation (requireAuth / optionalAuth) and RAG metrics
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Direct Postgres connection for migration scripts
DATABASE_URL=postgresql://postgres:<password>@db.your-project-id.supabase.co:5432/postgres?sslmode=require

# Optional: override API port (default: 8787)
# PORT=8787

# Optional: allow frontend origins in CORS (comma-separated)
# WEB_APP_ORIGIN=https://your-web-domain.railway.app,https://your-custom-domain.com
